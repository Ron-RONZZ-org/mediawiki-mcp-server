{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://wikibase.ronzz.org/contract/dataset-envelope.schema.json",
    "title": "Dataset manifest transport envelope",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "manifest": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "manifest_version": {
                    "type": "string",
                    "const": "1.0",
                    "description": "Manifest contract version; a consumer rejects an unknown major."
                },
                "dataset": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "dataset_id": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9-]*$",
                            "description": "Stable slug, e.g. bond-titus-1983."
                        },
                        "title": {
                            "type": "string",
                            "minLength": 1
                        },
                        "description": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "source_page": {
                            "type": "string"
                        },
                        "source_item": {
                            "type": "string",
                            "pattern": "^Q[0-9]+$"
                        },
                        "doi": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "year": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "minimum": 0,
                            "maximum": 9999
                        },
                        "licence": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "licence_label": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "rights_basis": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "rights_basis_label": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "access_tier": {
                            "type": "string",
                            "enum": [
                                "public",
                                "registered",
                                "internal"
                            ],
                            "description": "Audience tier. Orthogonal to the source PDF internal-use marker; never inferred from it."
                        },
                        "curator": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "status": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                "draft",
                                "reviewed",
                                "published",
                                "archived",
                                null
                            ],
                            "description": "Proposed status; the API controls the lifecycle."
                        }
                    },
                    "required": [
                        "dataset_id",
                        "title",
                        "access_tier"
                    ]
                },
                "tables": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "table_id": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "pattern": "^[a-z0-9][a-z0-9-]*$",
                                "description": "Stable key: dataset_id + \"-t\" + slug(table_number); the wiki derives it when omitted."
                            },
                            "table_number": {
                                "type": "string",
                                "minLength": 1
                            },
                            "caption": {
                                "type": "string"
                            },
                            "page": {
                                "type": "string"
                            },
                            "page_start": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "minimum": 1
                            },
                            "page_end": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "minimum": 1
                            },
                            "table_bbox": {
                                "type": [
                                    "array",
                                    "null"
                                ],
                                "items": {
                                    "type": "number"
                                },
                                "minItems": 4,
                                "maxItems": 4
                            },
                            "caption_bbox": {
                                "type": [
                                    "array",
                                    "null"
                                ],
                                "items": {
                                    "type": "number"
                                },
                                "minItems": 4,
                                "maxItems": 4
                            },
                            "source_index": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "minimum": 0
                            },
                            "pdf_file": {
                                "type": "string"
                            },
                            "pdf_sha1": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{40}$"
                            },
                            "pdf_revision": {
                                "type": [
                                    "integer",
                                    "null"
                                ],
                                "minimum": 1
                            },
                            "source_file_access": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "enum": [
                                    "public",
                                    "internal",
                                    null
                                ]
                            },
                            "extractor": {
                                "type": "string"
                            },
                            "extractor_version": {
                                "type": "string"
                            },
                            "method": {
                                "type": "string",
                                "enum": [
                                    "text-layer",
                                    "ocr",
                                    "vision",
                                    "manual"
                                ]
                            },
                            "confidence": {
                                "type": [
                                    "number",
                                    "null"
                                ],
                                "minimum": 0,
                                "maximum": 1
                            },
                            "review_status": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "enum": [
                                    "unreviewed",
                                    "checked",
                                    "verified",
                                    null
                                ]
                            },
                            "reviewer": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "review_date": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "date"
                            },
                            "notes": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "panels": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "panel_key": {
                                            "type": "string"
                                        },
                                        "panel_label": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "panel_order": {
                                            "type": "integer",
                                            "minimum": 0
                                        },
                                        "description": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "panel_key"
                                    ]
                                }
                            },
                            "columns": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "panel_key": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "column_key": {
                                            "type": "string"
                                        },
                                        "label": {
                                            "type": "string"
                                        },
                                        "description": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "unit": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "datatype": {
                                            "type": "string",
                                            "enum": [
                                                "integer",
                                                "float",
                                                "text",
                                                "date",
                                                "boolean"
                                            ]
                                        },
                                        "role": {
                                            "type": "string",
                                            "enum": [
                                                "dimension",
                                                "measure",
                                                "flag",
                                                "note"
                                            ]
                                        },
                                        "missing_token": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "sort_order": {
                                            "type": "integer",
                                            "minimum": 0
                                        },
                                        "column_parent_key": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "column_level": {
                                            "type": "integer",
                                            "minimum": 0
                                        }
                                    },
                                    "required": [
                                        "column_key",
                                        "label",
                                        "datatype",
                                        "role"
                                    ]
                                }
                            },
                            "observations": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "panel_key": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "row_index": {
                                            "type": "integer",
                                            "minimum": 0
                                        },
                                        "row_key": {
                                            "type": "string"
                                        },
                                        "row_label": {
                                            "type": "string"
                                        },
                                        "row_path": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "row_parent_key": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "row_depth": {
                                            "type": "integer",
                                            "minimum": 0
                                        },
                                        "column_key": {
                                            "type": "string"
                                        },
                                        "value_float": {
                                            "type": [
                                                "number",
                                                "null"
                                            ]
                                        },
                                        "value_int": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ]
                                        },
                                        "value_text": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "value_date": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date"
                                        },
                                        "flag_significant": {
                                            "type": "boolean"
                                        },
                                        "flag_note": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "footnote_keys": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "source_page": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "cell_bbox": {
                                            "type": [
                                                "array",
                                                "null"
                                            ],
                                            "items": {
                                                "type": "number"
                                            },
                                            "minItems": 4,
                                            "maxItems": 4
                                        }
                                    },
                                    "required": [
                                        "row_index",
                                        "row_key",
                                        "row_label",
                                        "column_key"
                                    ]
                                }
                            },
                            "footnotes": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "footnote_key": {
                                            "type": "string"
                                        },
                                        "marker_raw": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "text": {
                                            "type": "string"
                                        },
                                        "scope": {
                                            "type": "string",
                                            "enum": [
                                                "table",
                                                "column",
                                                "cell"
                                            ]
                                        },
                                        "language": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "sort_order": {
                                            "type": "integer",
                                            "minimum": 0
                                        },
                                        "status": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "enum": [
                                                "matched",
                                                "missing_note",
                                                "orphan_note",
                                                null
                                            ]
                                        }
                                    },
                                    "required": [
                                        "footnote_key",
                                        "text",
                                        "scope"
                                    ]
                                }
                            },
                            "extraction_runs": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "run_id": {
                                            "type": "string"
                                        },
                                        "tool": {
                                            "type": "string"
                                        },
                                        "tool_version": {
                                            "type": "string"
                                        },
                                        "model": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "prompt_version": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "started_at": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date-time"
                                        },
                                        "finished_at": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date-time"
                                        },
                                        "status": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "enum": [
                                                "ok",
                                                "needs_review",
                                                "failed",
                                                null
                                            ]
                                        },
                                        "confidence": {
                                            "type": [
                                                "number",
                                                "null"
                                            ],
                                            "minimum": 0,
                                            "maximum": 1
                                        },
                                        "report_json": {
                                            "type": [
                                                "object",
                                                "null"
                                            ],
                                            "additionalProperties": true
                                        },
                                        "diff_json": {
                                            "type": [
                                                "object",
                                                "null"
                                            ],
                                            "additionalProperties": true
                                        }
                                    },
                                    "required": [
                                        "run_id"
                                    ]
                                }
                            }
                        },
                        "required": [
                            "table_number",
                            "caption",
                            "page",
                            "columns",
                            "observations"
                        ]
                    }
                }
            },
            "required": [
                "manifest_version",
                "dataset",
                "tables"
            ]
        },
        "validation_report": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "ok",
                        "warnings",
                        "errors"
                    ]
                },
                "checks": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "code": {
                                "type": "string",
                                "enum": [
                                    "manifest-invalid",
                                    "referential-integrity",
                                    "pdf-provenance",
                                    "page-conflict",
                                    "page-too-large",
                                    "schema-mismatch",
                                    "store-error",
                                    "wikibase-write",
                                    "permission",
                                    "size-limit"
                                ]
                            },
                            "severity": {
                                "type": "string",
                                "enum": [
                                    "error",
                                    "warning",
                                    "info"
                                ]
                            },
                            "path": {
                                "type": "string"
                            },
                            "message": {
                                "type": "string"
                            },
                            "hint": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "code",
                            "severity",
                            "path",
                            "message"
                        ]
                    }
                },
                "summary": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "tables": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "panels": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "columns": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "observations": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "footnotes": {
                            "type": "integer",
                            "minimum": 0
                        }
                    },
                    "required": [
                        "tables",
                        "panels",
                        "columns",
                        "observations",
                        "footnotes"
                    ]
                },
                "tool": {
                    "type": "string"
                },
                "tool_version": {
                    "type": "string"
                },
                "generated_at": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "required": [
                "status",
                "checks",
                "summary",
                "tool",
                "tool_version",
                "generated_at"
            ]
        },
        "manifest_path": {
            "type": "string"
        }
    },
    "required": [
        "manifest"
    ]
}
